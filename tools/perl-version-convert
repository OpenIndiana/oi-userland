function usage
{
	[[ -n "$1" ]] && printf "ERROR: %s\n\n" "$1"
	printf "Usage: perl-version-convert DISTRIBUTION VERSION\n" >&2
	[[ -n "$1" ]] && exit 1
	exit 0
}


(($# == 0)) && usage
(($# == 1)) && usage "Missing VERSION to convert"
(($# > 2)) && usage "Too many arguments"

DISTRIBUTION="$1"
VERSION="$2"


function unsupported_version
{
	typeset -n C=$1
	typeset VERSION=$2

	printf "ERROR: Unsupported version format: %s\n" "$VERSION" >&2
	C="UNSUPPORTED_VERSION_FORMAT_$VERSION"
}

function convert_version
{
	typeset -n C=$1
	typeset PKG=$2
	typeset VERSION=$3

	typeset -a VER

	#
	# Handle special cases
	#
	# Notes:
	#
	# (*) Below we compare short package names and lowercased
	# distributions.
	#
	# (*) The version format for Authen-PAM is 0.XX, but it was integrated
	# as XX, so we need to follow that.
	#
	# (*) The actual version format for Crypt-PBKDF2 is 0.YYDDDR (YY -
	# year, DDD - day in year, R - release in the day) so it had to be
	# converted to 0.YY.DDD.R to be more accurate, but it was already
	# integrated as 0.YYDDDR, so we need to follow it for now, because
	# 0.YY.DDD.R would be considered older than 0.YYDDDR.  Possible
	# conversion of 0.YYDDDR to YY.DDD.R would cause problem in a case the
	# Crypt-PBKDF2 bump their major version.
	#
	# (*) Module-Build uses apparently version format 0.XXYY so it had to
	# be converted to 0.XX.YY, but it was already integrated as 0.XXYY, so
	# we need to follow it for now.
	#
	[[ "$PKG" == "authen-pam" && "${VERSION:0:2}" == "0." ]] && ((${#VERSION} == 4)) && VERSION=$((1${VERSION:2:2} - 100))
	[[ "$PKG" == "cpan-meta" && "${VERSION:0:2}" == "2." ]] && ((${#VERSION} == 8)) && VER[2]=$((1${VERSION:4:3} - 1000)) && VER[3]=$((1${VERSION:7:1} - 10)) && VERSION=${VERSION:0:4}
	[[ "$PKG" == "crypt-pbkdf2" && "${VERSION:0:2}" == "0." ]] && ((${#VERSION} == 8)) && VER[1]=$((1${VERSION:2:6} - 1000000)) && VERSION=${VERSION:0:1}
	[[ "$PKG" == "email-sender" && "${VERSION:0:2}" == "1." ]] && ((${#VERSION} == 8)) && VER[1]=${VERSION:2:1} && VER[2]=$((1${VERSION:3:5} - 100000)) && VERSION=${VERSION:0:1}
	[[ "$PKG" == "email-sender" && "${VERSION:0:2}" != "0." && "${VERSION:3:2}" == "00" ]] && ((${#VERSION} == 5)) && VER[1]=${VERSION:2:1} && VERSION=${VERSION:0:1}
	[[ "$PKG" == "email-sender" && "${VERSION:0:2}" != "0." ]] && ((${#VERSION} == 5)) && VER[1]=${VERSION:2:1} && VER[2]=$((1${VERSION:3:2} - 100)) && VERSION=${VERSION:0:1}
	[[ "$PKG" == "error" && "${VERSION:0:2}" == "0." ]] && ((${#VERSION} == 7)) && VER[2]=$((1${VERSION:4:3} - 1000)) && VERSION=${VERSION:0:4}
	[[ "$PKG" == "extutils-depends" && -n "${VERSION#*.???}" && "${VERSION#*.???}" != "$VERSION" ]] && VER[3]=${VERSION#*.???} && VERSION=${VERSION%${VER[3]}}
	[[ "$PKG" == "extutils-depends" && -n "${VERSION#*.?}" ]] && VER[2]=$((1${VERSION#*.?} - 100)) && VERSION=${VERSION%${VERSION#*.?}}
	[[ "$PKG" == "geography-countries" ]] && ((${#VERSION} == 10)) && VER[1]=$((1${VERSION:4:2} - 100)) && VER[2]=$((1${VERSION:6:2} - 100)) && VER[3]=$((1${VERSION:8:2} - 100)) && VERSION=${VERSION:0:4}
	[[ "$PKG" == "ipc-run" ]] && ((${#VERSION} == 3)) && VERSION="${VERSION}0"
	[[ "$PKG" == "ipc-run" ]] && ((${#VERSION} == 10)) && VER[3]=$((1${VERSION:9:1} - 10)) && VER[2]=$((1${VERSION:6:2} - 100)) && VER[1]=$((1${VERSION:4:2} - 100)) && VERSION=${VERSION:0:4}
	[[ "$PKG" == "json-pp" ]] && ((${#VERSION} == 7)) && VER[2]=$((1${VERSION:4:3} - 1000)) && VERSION=${VERSION:0:4}
	[[ "$PKG" == "log-dispatch" && "${VERSION:0:2}" == "1." ]] && ((${#VERSION} == 3)) && VERSION=${VERSION}0
	[[ "$PKG" == "log-dispatch" && "${VERSION:0:2}" == "1." ]] && ((${#VERSION} == 5)) && VER[2]=$((1${VERSION:4:1} - 10)) && VERSION=${VERSION:0:4}
	[[ "$PKG" == "mail-authenticationresults" && "${VERSION:0:2}" == "1." ]] && ((${#VERSION} == 10)) && VER[1]=$((1${VERSION:2:4} - 10000)) && VER[2]=$((1${VERSION:6:2} - 100)) && VER[3]=$((1${VERSION:8:2} - 100)) && VERSION=${VERSION:0:1}
	[[ "$PKG" == "mail-authenticationresults" && "${VERSION:0:2}" == "1." ]] && ((${#VERSION} == 12)) && VER[1]=$((1${VERSION:2:4} - 10000)) && VER[2]=$((1${VERSION:6:2} - 100)) && VER[3]=$((1${VERSION:8:2} - 100)) && VER[4]=${VERSION:11:1} && VERSION=${VERSION:0:1}
	[[ "$PKG" == "mail-authenticationresults" && "${VERSION:0:2}" == "2." ]] && ((${#VERSION} == 10)) && VER[1]=$((1${VERSION:2:4} - 10000)) && VER[2]=$((1${VERSION:6:2} - 100)) && VER[3]=$((1${VERSION:8:2} - 100)) && VERSION=${VERSION:0:1}
	[[ "$PKG" == "mail-authenticationresults" && "${VERSION:0:2}" == "2." ]] && ((${#VERSION} == 12)) && VER[1]=$((1${VERSION:2:4} - 10000)) && VER[2]=$((1${VERSION:6:2} - 100)) && VER[3]=$((1${VERSION:8:2} - 100)) && VER[4]=${VERSION:11:1} && VERSION=${VERSION:0:1}
	[[ "$PKG" == "mail-dkim" && "${VERSION:0:2}" == "1." ]] && ((${#VERSION} == 10)) && VER[1]=$((1${VERSION:2:4} - 10000)) && VER[2]=$((1${VERSION:6:2} - 100)) && VER[3]=$((1${VERSION:8:2} - 100)) && VERSION=${VERSION:0:1}
	[[ "$PKG" == "mail-dkim" && "${VERSION:0:2}" == "1." ]] && ((${#VERSION} == 12)) && VER[1]=$((1${VERSION:2:4} - 10000)) && VER[2]=$((1${VERSION:6:2} - 100)) && VER[3]=$((1${VERSION:8:2} - 100)) && VER[4]=${VERSION:11:1} && VERSION=${VERSION:0:1}
	[[ "$PKG" == "mail-dmarc" && "${VERSION:1:1}" == "." ]] && ((${#VERSION} == 10)) && VER[1]=$((1${VERSION:2:4} - 10000)) && VER[2]=$((1${VERSION:6:2} - 100)) && VER[3]=$((1${VERSION:8:2} - 100)) && VERSION=${VERSION:0:1}
	[[ "$PKG" == "mail-dmarc" && "${VERSION:0:2}" == "0." ]] && ((${#VERSION} == 8)) && VER[1]=$((1${VERSION:2:2} - 100)) && VER[2]=$((1${VERSION:4:3} - 1000)) && VER[3]=$((1${VERSION:7:1} - 10)) && VERSION=${VERSION:0:1}
	[[ "$PKG" == "mail-spf" && "${VERSION:0:2}" == "3." ]] && ((${#VERSION} == 10)) && VER[1]=$((1${VERSION:2:4} - 10000)) && VER[2]=$((1${VERSION:6:2} - 100)) && VER[3]=$((1${VERSION:8:2} - 100)) && VERSION=${VERSION:0:1}
	[[ "$PKG" == "math-bigint" && "${VERSION:0:2}" == "1." ]] && ((${#VERSION} == 5)) && VERSION=${VERSION}0
	[[ "$PKG" == "math-bigint" && "${VERSION:0:2}" == "1." ]] && ((${#VERSION} == 8)) && VER[3]=$((1${VERSION:6:2} - 100)) && VERSION=${VERSION:0:6}
	[[ "$PKG" == "mime-base32" ]] && VERSION=${VERSION/%a/.1}
	[[ "$PKG" == "module-build" ]] && ((${#VERSION} == 6)) && VER[1]=$((1${VERSION:2:4} - 10000)) && VERSION=${VERSION:0:1}
	[[ "$PKG" == "mozilla-ca" ]] && ((${#VERSION} == 8)) && VER[1]=$((1${VERSION:4:2} - 100)) && VER[2]=$((1${VERSION:6:2} - 100)) && VERSION=${VERSION:0:4}
	[[ "$PKG" == "net-dns-resolver-mock" && "${VERSION:0:2}" == "1." ]] && ((${#VERSION} == 10)) && VER[1]=$((1${VERSION:2:4} - 10000)) && VER[2]=$((1${VERSION:6:2} - 100)) && VER[3]=$((1${VERSION:8:2} - 100)) && VERSION=${VERSION:0:1}
	[[ "$PKG" == "net-imap-simple" ]] && ((${#VERSION} == 7)) && VER[3]=$((1${VERSION:6:1} - 10)) && VERSION=${VERSION:0:6}
	[[ "$PKG" == "perl-critic" && "${VERSION:0:2}" == "0." ]] && ((${#VERSION} == 3)) && VERSION=${VERSION}0
	[[ "$PKG" == "perl-critic" && "${VERSION:0:2}" == "1." ]] && ((${#VERSION} == 4)) && VERSION=${VERSION}0
	[[ "$PKG" == "perl-tidy" ]] && ((${#VERSION} == 8)) && VER[1]=$((1${VERSION:4:2} - 100)) && VER[2]=$((1${VERSION:6:2} - 100)) && VERSION=${VERSION:0:4}
	[[ "$PKG" == "perlfaq" && "${VERSION:0:4}" == "5.20" ]] && ((${#VERSION} == 10)) && VER[1]=$((1${VERSION:2:4} - 10000)) && VER[2]=$((1${VERSION:6:2} - 100)) && VER[3]=$((1${VERSION:8:2} - 100)) && VERSION=${VERSION:0:1}
	[[ "$PKG" == "pkgconfig" && "${VERSION:4:3}" == "026" ]] && ((${#VERSION} == 7)) && VER[1]=$((1${VERSION:2:2} - 100)) && VERSION=${VERSION:0:1}
	[[ "$PKG" == "proc-processtable" && "${VERSION:0:2}" == "0." ]] && ((${#VERSION} == 5)) && VER[2]=$((1${VERSION:4:1} - 10)) && VERSION=${VERSION:0:4}
	[[ "$PKG" == "regexp-common" ]] && ((${#VERSION} == 10)) && VER[1]=$((1${VERSION:4:2} - 100)) && VER[2]=$((1${VERSION:6:2} - 100)) && VER[3]=$((1${VERSION:8:2} - 100)) && VERSION=${VERSION:0:4}
	[[ "$PKG" == "sereal-decoder" ]] && ((${VERSION%%.*} > 2)) && [[ -z "${VERSION/*.*}" ]] && while [[ "${VERSION/*.???}" == "$VERSION" ]] do VERSION=${VERSION}0 ; done
	[[ "$PKG" == "test-regexp" ]] && ((${#VERSION} == 10)) && VER[1]=$((1${VERSION:4:2} - 100)) && VER[2]=$((1${VERSION:6:2} - 100)) && VER[3]=$((1${VERSION:8:2} - 100)) && VERSION=${VERSION:0:4}
	[[ "$PKG" == "yaml-libyaml" && "${VERSION:0:4}" == "0.90" && "${VERSION:5:1}" == "." ]] && ((${#VERSION} == 7)) && VER[2]=$((1${VERSION:4:1} - 10)) && VER[3]=$((1${VERSION:6:1} - 10)) && VERSION=${VERSION:0:4}

	C=
	VER[0]=${VERSION%%.*}

	if [[ "${VER[0]}" != "$VERSION" ]] ; then
		V=${VERSION#*.}

		# Currently we do not support underscore in version
		V=${V//*_*}

		case "$V" in
		?)	VER[1]=$V ;;
		??)	VER[1]=$((1$V - 100)) ;;
		?.?)	VER[1]=${V:0:1} && VER[2]=${V:2:1} ;;
		???)	VER[1]=$((1$V - 1000)) ;;
		?.??)	VER[1]=${V:0:1} && VER[2]=$((1${V:2:2} - 100)) ;;
		??.?)	VER[1]=$((1${V:0:2} - 100)) && VER[2]=${V:3:1} ;;
		????)	VER[1]=$((1${V:0:2} - 100)) && VER[2]=$((1${V:2:2} - 100)) ;;
		??.??)	VER[1]=$((1${V:0:2} - 100)) && VER[2]=$((1${V:3:2} - 100)) ;;
		???.?)	VER[1]=$((1${V:0:3} - 1000)) && VER[2]=$((1${V:4:1} - 10)) ;;
		?.????)	unsupported_version C $VERSION ; return ;;
		??.???)	unsupported_version C $VERSION ; return ;;
		???.??)	unsupported_version C $VERSION ; return ;;
		????.?)	unsupported_version C $VERSION ; return ;;
		??????)	VER[1]=$((1${V:0:3} - 1000)) ; VER[2]=$((1${V:3:3} - 1000)) ;;
		???.???)VER[1]=$((1${V:0:3} - 1000)) && VER[2]=$((1${V:4:3} - 1000)) ;;
		*)	unsupported_version C $VERSION ; return ;;
		esac
	fi

	i=0
	while ((i < ${#VER[@]})) ; do
		((i > 0)) && C="$C."
		C="$C${VER[$i]}"
		i=$((i + 1))
	done
}


# Convert distribution name to lowercase to normalize it.  This will allow the
# script to be called with the short package name to support perl-meta-deps.
# For convenience we replace '::' by '-' in a case somebody calls this script
# with module name instead of distribution name.
convert_version VER "$(tr '[A-Z]' '[a-z]' <<< "${DISTRIBUTION//::/-}")" "$VERSION"
printf "%s\n" "$VER"
