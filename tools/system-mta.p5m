#
# This is fake manifest used for pkgdepend resolve (see make-rules/ips.mk) to
# force regular packages to depend on pkg:/system/mta meta package instead of
# pkg:/service/network/smtp/sendmail, pkg:/service/network/smtp/postfix, or
# similar packages directly.
#
# Only entries that are mediated by pkg:/service/network/smtp/sendmail,
# pkg:/service/network/smtp/postfix, or similar packages or provided by
# pkg:/system/mta should be listed here.
#

set name=pkg.fmri value=pkg:/system/mta

file path=usr/lib/sendmail owner=root group=bin mode=0555
