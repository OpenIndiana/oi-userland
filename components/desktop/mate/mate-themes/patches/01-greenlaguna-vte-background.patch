VTE uses text_view_bg for its application-priority terminal background CSS.
Without it, GreenLaguna renders black text on an opaque black background.

--- a/desktop-themes/GreenLaguna/gtk-3.0/gtk-main.css
+++ b/desktop-themes/GreenLaguna/gtk-3.0/gtk-main.css
@@ -11,6 +11,7 @@
 @define-color tooltip_fg_color #000000;
 
 @define-color theme_base_color @base_color;
+@define-color text_view_bg @theme_base_color; /* VTE terminal background */
 @define-color theme_bg_color @bg_color;
 @define-color theme_text_color @text_color;
 @define-color theme_fg_color @fg_color;
