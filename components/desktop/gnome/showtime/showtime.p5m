set name=pkg.fmri value=pkg:/$(COMPONENT_FMRI)@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.human-version value=$(HUMAN_VERSION)
set name=pkg.summary value="$(COMPONENT_SUMMARY)"
set name=info.classification value="$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=info.source-url value=$(COMPONENT_ARCHIVE_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)

license $(COMPONENT_LICENSE_FILE) license='$(COMPONENT_LICENSE)'


# Loaded through GObject introspection; the video goes through
# gtk4paintablesink (plugin/gtk4).  GstPlay is in the encumbered
# plugin/bad, which cannot be a dependency here.
depend type=require fmri=library/audio/gstreamer
depend type=require fmri=library/audio/gstreamer/plugin/base
depend type=require fmri=library/audio/gstreamer/plugin/good
depend type=require fmri=library/audio/gstreamer/plugin/gtk4
depend type=require fmri=library/desktop/graphene
depend type=require fmri=library/desktop/gtk4
depend type=require fmri=library/desktop/libadwaita

file path=usr/bin/showtime
file path=usr/lib/python$(PYVER)/vendor-packages/showtime/__init__.py
file path=usr/lib/python$(PYVER)/vendor-packages/showtime/application_delegate.py
file path=usr/lib/python$(PYVER)/vendor-packages/showtime/drag_overlay.py
file path=usr/lib/python$(PYVER)/vendor-packages/showtime/logging/color_log_formatter.py
file path=usr/lib/python$(PYVER)/vendor-packages/showtime/logging/session_file_handler.py
file path=usr/lib/python$(PYVER)/vendor-packages/showtime/logging/setup.py
file path=usr/lib/python$(PYVER)/vendor-packages/showtime/main.py
file path=usr/lib/python$(PYVER)/vendor-packages/showtime/messenger.py
file path=usr/lib/python$(PYVER)/vendor-packages/showtime/mpris.py
file path=usr/lib/python$(PYVER)/vendor-packages/showtime/play.py
file path=usr/lib/python$(PYVER)/vendor-packages/showtime/shared.py
file path=usr/lib/python$(PYVER)/vendor-packages/showtime/utils.py
file path=usr/lib/python$(PYVER)/vendor-packages/showtime/window.py
