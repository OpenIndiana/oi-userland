set name=pkg.fmri value=pkg:/database/mariadb-123@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.human-version value=$(HUMAN_VERSION)
set name=pkg.summary value="MariaDB 12.3 Database Management System"
set name=info.classification value="$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=info.source-url value=$(COMPONENT_ARCHIVE_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)

license $(COMPONENT_LICENSE_FILE) license='$(COMPONENT_LICENSE)'

<transform file path=usr.*/man/.+ -> default mangler.man.stability committed>
<transform file path=.*/bin/.+ -> default mode 0555>

dir path=var/mariadb group=mysql mode=0700 owner=mysql
dir path=var/mariadb/12.3 group=mysql mode=0700 owner=mysql
dir path=var/mariadb/12.3/data group=mysql mode=0700 owner=mysql
file files/my-medium.cnf path=etc/mariadb/12.3/my.cnf.d/default.cnf \
    mode=0644 preserve=renamenew
file path=etc/mariadb/12.3/my.cnf
file path=etc/mariadb/12.3/logrotate.d/mariadb
#file path=etc/mariadb/12.3/init.d/mysql
file files/auth_attr path=etc/security/auth_attr.d/mariadb-123
file files/prof_attr path=etc/security/prof_attr.d/mariadb-123
file files/mariadb_123.xml \
    path=lib/svc/manifest/application/database/mariadb_123.xml
file files/mariadb_123 path=lib/svc/method/mariadb_123 mode=0555


link path=etc/mysql/my.cnf target=../mariadb/12.3/my.cnf mediator=mysql mediator-version=12.3 mediator-implementation=mariadb
link path=usr/mysql/bin target=../mariadb/12.3/bin mediator=mysql mediator-version=12.3 mediator-implementation=mariadb
link path=usr/mysql/docs target=../mariadb/12.3/docs mediator=mysql mediator-version=12.3 mediator-implementation=mariadb
link path=usr/mysql/man target=../mariadb/12.3/man mediator=mysql mediator-version=12.3 mediator-implementation=mariadb
link path=usr/mysql/share target=../mariadb/12.3/share mediator=mysql mediator-version=12.3 mediator-implementation=mariadb
link path=var/mysql/data target=../mariadb/12.3/data mediator=mysql mediator-version=12.3 mediator-implementation=mariadb

depend fmri=database/mysql-common type=require
depend fmri=database/mariadb-123/client@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION) type=require

dir  path=usr/mariadb/12.3/docs

