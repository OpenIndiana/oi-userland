-  set cmd "$CMD -DUSE_TCL_STUBS tclsqlite3.c -o $OUT [join $LIBS { }]"
+  set cmd "$CMD -DUSE_TCL_STUBS tclsqlite3.c -fPIC -o $OUT [join $LIBS { }]"
