#
# OpenIndiana specific patch to provide support for configuration
# fragment files by default.
# This is intentionally separate from any other patch that modifies
# sshd_config so that over time those changes may be able to be delivered
# as fragement files rather than patching the source.
--- openssh-10.3p1/ssh_config.orig
+++ openssh-10.3p1/ssh_config
@@ -43,3 +43,5 @@
 #   ProxyCommand ssh -q -W %h:%p gateway.example.com
 #   RekeyLimit 1G 1h
 #   UserKnownHostsFile ~/.ssh/known_hosts.d/%k
+#
+    Include /etc/ssh/ssh_config.d/*.conf
--- openssh-10.3p1/sshd_config.orig
+++ openssh-10.3p1/sshd_config
@@ -120,3 +120,5 @@
 #	AllowTcpForwarding no
 #	PermitTTY no
 #	ForceCommand cvs server
+#
+Include /etc/ssh/sshd_config.d/*.conf
