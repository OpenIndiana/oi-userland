set name=pkg.fmri value=pkg:/$(COMPONENT_FMRI)@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.human-version value=$(HUMAN_VERSION)
set name=pkg.summary value="$(COMPONENT_SUMMARY)"
set name=info.classification value="$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=info.source-url value=$(COMPONENT_ARCHIVE_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)

license $(COMPONENT_LICENSE_FILE) license='$(COMPONENT_LICENSE)'

file path=usr/bin/wayland-scanner
file path=usr/include/wayland-client-core.h
file path=usr/include/wayland-client-protocol-core.h
file path=usr/include/wayland-client-protocol.h
file path=usr/include/wayland-client.h
file path=usr/include/wayland-server-core.h
file path=usr/include/wayland-server-private.h
file path=usr/include/wayland-server-protocol-core.h
file path=usr/include/wayland-server-protocol.h
file path=usr/include/wayland-server.h
file path=usr/include/wayland-util.h
file path=usr/include/wayland-version.h
file path=usr/lib/$(MACH64)/libwayland-client.a
file path=usr/lib/$(MACH64)/libwayland-client.so
file path=usr/lib/$(MACH64)/libwayland-server.a
file path=usr/lib/$(MACH64)/libwayland-server.so
file path=usr/lib/$(MACH64)/pkgconfig/wayland-client.pc
file path=usr/lib/$(MACH64)/pkgconfig/wayland-scanner.pc
file path=usr/lib/$(MACH64)/pkgconfig/wayland-server.pc
file path=usr/share/wayland/wayland.dtd
file path=usr/share/wayland/wayland.xml
