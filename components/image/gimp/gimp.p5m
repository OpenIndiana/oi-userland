set name=pkg.fmri value=pkg:/$(COMPONENT_FMRI)@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.human-version value=$(HUMAN_VERSION)
set name=pkg.summary value="$(COMPONENT_SUMMARY)"
set name=info.classification value="$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=info.source-url value=$(COMPONENT_ARCHIVE_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)

license $(COMPONENT_LICENSE_FILE) license='$(COMPONENT_LICENSE)'

<transform file path=usr/lib/$(MACH64)/gimp/3.0/plug-ins/.*/.* -> default mode 0555>
# python files in non-standard locations need to be bypassed
<transform file path=usr/lib/$(MACH64)/gimp/3.0/plug-ins/.*/.*.py -> add pkg.depend.bypass-generate .*>
<transform file path=etc/gimp/3.0/.* -> default preserve true>

# Suppress the following pkglint error:
# ERROR userland.action002.0        link usr/share/doc/gimp-3.0/images/gimp-devel-logo.png has unresolvable target '/usr/share/gimp/3.0/images/gimp-devel-logo.png'
<transform link path=usr/share/doc/gimp-3.0/images/gimp-devel-logo.png -> default pkg.linted.userland.action002.0 true>

depend type=require fmri=pkg:/image/graphviz
depend type=require fmri=pkg:/library/mypaint-brushes
# welcome dialog box needs an emoji font to be installed
depend type=require fmri=pkg:/system/font/truetype/noto-emoji

