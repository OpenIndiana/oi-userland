                                "b-emacs.pdmp"
                              "bootstrap-emacs.pdmp"))
-                          (t (error "Unrecognized dump mode %s" dump-mode)))))
+                          (t (error "Unrecognized dump mode %s" dump-mode))))
+            (exec-path nil))
