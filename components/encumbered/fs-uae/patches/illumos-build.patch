--- fs-uae-3.2.35/configure.ac.orig
+++ fs-uae-3.2.35/configure.ac
@@ -330,6 +330,10 @@
 
 AC_CHECK_LIB([Ws2_32], [main])
 
+# illumos and Solaris have the socket functions in libsocket and libnsl
+AC_SEARCH_LIBS([socket], [socket])
+AC_SEARCH_LIBS([gethostbyname], [nsl])
+
 
 # Operating system
 
@@ -398,6 +402,13 @@
     OS_CPPFLAGS="-DDRAGONFLYBSD"
     LOADABLE_MODULE_EXT=".so"
 ],
+[solaris*], [
+    OS_NAME="solaris"
+    OS_NAME_2="Solaris"
+    OS_NAME_3="Solaris"
+    OS_CPPFLAGS="-DSOLARIS"
+    LOADABLE_MODULE_EXT=".so"
+],
 [
     OS_NAME="unknown"
     OS_NAME_2="Unknown OS"
--- fs-uae-3.2.35/src/include/sysdeps.h.orig
+++ fs-uae-3.2.35/src/include/sysdeps.h
@@ -172,7 +172,7 @@
 
 /* If char has more then 8 bits, good night. */
 typedef unsigned char uae_u8;
-typedef signed char uae_s8;
+typedef int8_t uae_s8;
 typedef char uae_char;
 
 typedef struct { uae_u8 RGB[3]; } RGB;
