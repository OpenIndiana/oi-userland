fs-uae JIT on illumos: include <sys/regset.h> for the REG_RAX... gregs
indices. Solaris 11.4's <sys/ucontext.h> pulls it in; illumos' does not, so
src/jit/exception_handler.cpp did not compile with --enable-jit.

--- a/src/jit/exception_handler.cpp	2026-11-08 22:49:51.587027505 +0100
+++ b/src/jit/exception_handler.cpp	2026-11-08 22:49:51.755027719 +0100
@@ -10,6 +10,10 @@
 #define __USE_GNU
 #endif
 #include <sys/ucontext.h>
+#ifdef __sun
+/* illumos: <sys/ucontext.h> does not bring in the REG_* gregs indices */
+#include <sys/regset.h>
+#endif
 #endif
 #include <signal.h>
 
