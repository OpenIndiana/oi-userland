     if (fs_config_get_boolean(OPTION_JIT_COMPILER) == 1) {
+#ifdef JIT
         amiga_init_jit_compiler();
+#else
+        fs_emu_warning(_("JIT compiler is not available on this CPU, "
+                         "using the interpreter"));
+#endif
     }
 
