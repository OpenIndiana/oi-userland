--- a/src/pt2_helpers.h
+++ b/src/pt2_helpers.h
@@ -3,13 +3,13 @@
 #include <stdint.h>
 #include <stdbool.h>
 
-#define SWAP16(value) \
+#define BSWAP16(value) \
 ( \
 	(((uint16_t)((value) & 0x00FF)) << 8) | \
