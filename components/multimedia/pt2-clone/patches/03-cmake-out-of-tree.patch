Build the executable in the build directory: CMakeLists.txt puts it into
release/other in the source tree.

Upstream status: offered upstream (https://github.com/8bitbubsy/pt2-clone/pull/55)

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -3,7 +3,6 @@
 project(pt2-clone)
 
 find_package(SDL2 REQUIRED)
-set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${pt2-clone_SOURCE_DIR}/release/other/")
 
 if((CMAKE_CXX_COMPILER_ID MATCHES "Clang") OR (CMAKE_CXX_COMPILER_ID MATCHES "GNU"))
 	add_compile_options(-O3)
