Identify the driver build without a GNU build-id note (illumos ld emits none).

iris, crocus and virgl assert a build-id note and dereference it when they
create the disk cache, and anv refuses to create a physical device without
one.  Without the note, fall back to disk_cache_get_function_identifier()
(the driver's modification time, as radeonsi and llvmpipe use); with it,
the cache keys stay what they were.  Upstreamable.

--- src/gallium/drivers/crocus/crocus_disk_cache.c.orig
+++ src/gallium/drivers/crocus/crocus_disk_cache.c
@@ -243,15 +243,23 @@
       snprintf(renderer, sizeof(renderer), "crocus_%04x", screen->pci_id);
    assert(len == sizeof(renderer) - 2);
 
+   char timestamp[41];
    const struct build_id_note *note =
       build_id_find_nhdr_for_addr(crocus_disk_cache_init);
-   assert(note && build_id_length(note) == 20); /* sha1 */
-
-   const uint8_t *id_sha1 = build_id_data(note);
-   assert(id_sha1);
-
-   char timestamp[41];
-   _mesa_sha1_format(timestamp, id_sha1);
+   if (note && build_id_length(note) == 20) {
+      _mesa_sha1_format(timestamp, build_id_data(note));
+   } else {
+      /* No GNU build-id note (the illumos link-editor emits none): identify
+       * the build by the driver's modification time.
+       */
+      struct mesa_sha1 id_ctx;
+      uint8_t id_sha1[20];
+      _mesa_sha1_init(&id_ctx);
+      if (!disk_cache_get_function_identifier(crocus_disk_cache_init, &id_ctx))
+         return;
+      _mesa_sha1_final(&id_ctx, id_sha1);
+      _mesa_sha1_format(timestamp, id_sha1);
+   }
 
    const uint64_t driver_flags =
       elk_get_compiler_config_value(screen->compiler);
