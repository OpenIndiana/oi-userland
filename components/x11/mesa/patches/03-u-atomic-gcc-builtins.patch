Use the GCC atomic builtins on illumos when building with GCC.

The Solaris <atomic.h> path lacks p_atomic_read_relaxed(), which
u_debug.h and u_call_once.h use since 24.x.  (pkgsrc carries the same
change.)  Upstreamable.

--- src/util/u_atomic.h.orig
+++ src/util/u_atomic.h
@@ -20,7 +20,7 @@
  * locally coded assembly, compiler intrinsic or ultimately a
  * mutex-based implementation.
  */
-#if defined(__sun)
+#if defined(__sun) && !defined(__GNUC__)
 #define PIPE_ATOMIC_OS_SOLARIS
 #elif defined(_MSC_VER)
 #define PIPE_ATOMIC_MSVC_INTRINSIC
