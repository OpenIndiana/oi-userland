Integration of Display Manager (gdm/xdm/etc.) to X server communication pipe
with core server code - see sun-src/os/dtlogin.c for the main implementation.

diff --git a/configure.ac b/configure.ac
index a2a14f6..d7b878e 100644
--- a/configure.ac
+++ b/configure.ac
@@ -1658,6 +1658,7 @@ AM_CONDITIONAL(HAVE_LIBUNWIND, [test "x$LIBUNWIND" = xyes])
 XSERVER_CFLAGS="${XSERVER_CFLAGS} ${XSERVERCFLAGS_CFLAGS}"
 XSERVER_LIBS="$DIX_LIB $MI_LIB $OS_LIB"
 XSERVER_SYS_LIBS="${XSERVERLIBS_LIBS} ${SYS_LIBS} ${LIBS}"
+XSERVER_SYS_LIBS="${XSERVER_SYS_LIBS} -lproject"
 AC_SUBST([XSERVER_LIBS])
 AC_SUBST([XSERVER_SYS_LIBS])
 
diff --git a/dix/main.c b/dix/main.c
index 29df4ef..27592b2 100644
--- a/dix/main.c
+++ b/dix/main.c
@@ -117,6 +117,11 @@ Equipment Corporation.
 #include "dpmsproc.h"
 #endif
 
+#ifdef SUNSOFT
+extern void DtloginInit(void);
+extern void DtloginCloseDown(void);
+#endif /* SUNSOFT */
+
 extern void Dispatch(void);
 
 CallbackListPtr RootWindowFinalizeCallback = NULL;
@@ -149,6 +154,13 @@ dix_main(int argc, char *argv[], char *envp[])
         InitBlockAndWakeupHandlers();
         /* Perform any operating system dependent initializations you'd like */
         OsInit();
+
+#ifdef SUNSOFT
+        /* Create pipe for dtlogin authentication info before we tell dtlogin 
+           we're done and ready for it to run. */
+        DtloginInit ();
+#endif
+
         if (serverGeneration == 1) {
             CreateWellKnownSockets();
             for (i = 1; i < LimitClients; i++)
@@ -276,6 +288,11 @@ dix_main(int argc, char *argv[], char *envp[])
 
         UnrefCursor(rootCursor);
 
+#ifdef SUNSOFT
+        /* Return to root privs before calling the rest of close down */
+        DtloginCloseDown ();
+#endif
+
         UndisplayDevices();
         DisableAllDevices();
 
diff --git a/os/Makefile.am b/os/Makefile.am
index c2ee8b8..3ee6ff9 100644
--- a/os/Makefile.am
+++ b/os/Makefile.am
@@ -55,6 +55,9 @@ if BUSFAULT
 libos_la_SOURCES += $(BUSFAULT_SRCS)
 endif
 
+libos_la_SOURCES += dtlogin.c
+libos_la_LIBADD += -lproject
+
 EXTRA_DIST = $(SECURERPC_SRCS) $(XDMCP_SRCS)
 
 if SPECIAL_DTRACE_OBJECTS
diff --git a/os/auth.c b/os/auth.c
index 243d3c5..5cdc14b 100644
--- a/os/auth.c
+++ b/os/auth.c
@@ -283,6 +283,19 @@ AddAuthorization(unsigned name_length, const char *name,
     return 0;
 }
 
+#ifdef SUNSOFT
+/* This function is called from dtlogin.c 
+ * This is added to do "chmod authorization_file" since
+ * this file is owned by root and we need to change this
+ * to user logged on.  
+ */
+const char *
+GetAuthFilename(void)
+{
+    return (authorization_file);
+}
+#endif
+
 #ifdef XCSECURITY
 
 XID
