Add missing encoding aliases.  It may be contributed upstream at some point,
but the suitability (or lack thereof) has not yet been determined.

The patch comes from solaris-userland.

--- Python-3.15.2/Lib/encodings/aliases.py.orig
+++ Python-3.15.2/Lib/encodings/aliases.py
@@ -86,6 +86,7 @@
 
     # cp1251 codec
     '1251'               : 'cp1251',
+    'ansi_1251'          : 'cp1251',
     'cswindows1251'      : 'cp1251',
     'windows_1251'       : 'cp1251',
 
@@ -272,6 +273,7 @@
     'u_jis'              : 'euc_jp',
 
     # euc_kr codec
+    '5601'               : 'euc_kr',
     'cseuckr'            : 'euc_kr',
     'euckr'              : 'euc_kr',
 
@@ -546,6 +548,7 @@
     'shiftjis'           : 'shift_jis',
     'sjis'               : 'shift_jis',
     's_jis'              : 'shift_jis',
+    'pck'                : 'shift_jis',
 
     # shift_jis_2004 codec
     'shiftjis2004'       : 'shift_jis_2004',
@@ -563,6 +566,7 @@
     'tis_620_0'          : 'tis_620',
     'tis_620_2529_0'     : 'tis_620',
     'tis_620_2529_1'     : 'tis_620',
+    'tis620.2533'        : 'tis_620',
     'iso_ir_166'         : 'tis_620',
 
     # utf_16 codec
