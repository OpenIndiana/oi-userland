None of pip, tox-envlist, and virtualenv are needed to run tests.
tox version pin is too strict.

--- dom_toml-2.3.0/tox.ini.orig
+++ dom_toml-2.3.0/tox.ini
@@ -37,11 +37,6 @@
     build
 skip_missing_interpreters = True
 isolated_build = True
-requires =
-    pip>=21,!=22.2
-    tox-envlist>=0.2.1
-    tox~=3.0
-    virtualenv!=20.16.0
 
 [envlists]
 test = py37, py38, py39, py310, py311, py312, py313, pypy37, pypy38, pypy39
