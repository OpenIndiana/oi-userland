tox-uv is not needed to run tests in our environment.

--- toml_fmt_common-1.3.2/tox.toml.orig
+++ toml_fmt_common-1.3.2/tox.toml
@@ -1,10 +1,9 @@
-requires = ["tox>=4.49.1", "tox-uv>=1.33.4"]
+requires = ["tox>=4.49.1"]
 env_list = ["fix", "3.14", "3.13", "3.12", "3.11", "3.10", "type", "pkg_meta"]
 skip_missing_interpreters = true
 
 [env_run_base]
 description = "run the tests with pytest under {env_name}"
-runner = "uv-venv-lock-runner"
 package = "wheel"
 wheel_build_env = ".pkg"
 dependency_groups = ["test"]
