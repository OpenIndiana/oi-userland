We cannot run the no_jupyter tests because we always have the jupyter extras
installed.

--- black-25.9.0/tox.ini.orig
+++ black-25.9.0/tox.ini
@@ -17,9 +17,6 @@
     jupyter
 commands =
     coverage erase
-    pytest tests --run-optional no_jupyter \
-        --numprocesses auto \
-        --cov {posargs}
     pytest tests --run-optional jupyter \
         -m jupyter \
         --numprocesses auto \
