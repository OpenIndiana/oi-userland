We do not need to check coverage for this project.

--- termcolor-3.2.0/pyproject.toml.orig
+++ termcolor-3.2.0/pyproject.toml
@@ -45,7 +45,6 @@
 dynamic = [ "version" ]
 optional-dependencies.tests = [
   "pytest",
-  "pytest-cov",
 ]
 urls.Changelog = "https://github.com/termcolor/termcolor/releases"
 urls.Homepage = "https://github.com/termcolor/termcolor"
--- termcolor-3.2.0/tox.ini.orig
+++ termcolor-3.2.0/tox.ini
@@ -13,12 +13,6 @@
     FORCE_COLOR
 commands =
     {envpython} -m pytest \
-      --cov termcolor \
-      --cov tests \
-      --cov-context test \
-      --cov-report html \
-      --cov-report term \
-      --cov-report xml \
       {posargs}
 
 [testenv:lint]
