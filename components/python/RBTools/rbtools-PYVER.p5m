# python modules are unusable without python runtime binary
depend type=require fmri=__TBD pkg.debug.depend.file=python$(PYVER) \
    pkg.debug.depend.path=usr/bin

# Automatically generated dependencies based on distribution metadata
depend type=require fmri=pkg:/library/python/certifi-$(PYV)
depend type=require fmri=pkg:/library/python/colorama-$(PYV)
depend type=require fmri=pkg:/library/python/housekeeping-$(PYV)
depend type=require fmri=pkg:/library/python/importlib-metadata-$(PYV)
depend type=require fmri=pkg:/library/python/importlib-resources-$(PYV)
depend type=require fmri=pkg:/library/python/packaging-$(PYV)
depend type=require fmri=pkg:/library/python/puremagic-$(PYV)
depend type=require fmri=pkg:/library/python/pydiffx-$(PYV)
depend type=require fmri=pkg:/library/python/texttable-$(PYV)
depend type=require fmri=pkg:/library/python/tqdm-$(PYV)
depend type=require fmri=pkg:/library/python/typing-extensions-$(PYV)
<transform file path=usr/bin -> add pkg.depend.bypass-generate .*/importlib_metadata.* >
<transform file path=usr/bin -> add pkg.depend.bypass-generate .*/pkg_resources.* >
