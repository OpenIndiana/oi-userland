file path=usr/lib/python$(PYVER)/vendor-packages/chardet/__init__.py
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/__main__.py
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/_utils.py
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/_version.py
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/cli.py
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/detector.py
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/enums.py
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/equivalences.py
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/evaluation.py
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/models/__init__.py
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/models/confusion.bin
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/models/idf.bin
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/models/models.bin
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/models/rowmax.bin
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/models/training_metadata.yaml
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/output_names.py
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/pipeline/__init__.py
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/pipeline/ascii.py
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/pipeline/binary.py
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/pipeline/bom.py
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/pipeline/confusion.py
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/pipeline/escape.py
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/pipeline/language.py
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/pipeline/magic.py
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/pipeline/markup.py
