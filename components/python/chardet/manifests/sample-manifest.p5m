file path=usr/lib/python$(PYVER)/vendor-packages/chardet/pipeline/postprocess.py
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/pipeline/statistical.py
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/pipeline/structural.py
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/pipeline/utf1632.py
file path=usr/lib/python$(PYVER)/vendor-packages/chardet/pipeline/utf8.py
