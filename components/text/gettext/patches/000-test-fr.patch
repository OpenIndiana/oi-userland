#
# Add links for ISO8859-1 and UTF-8 fr support so that a few tests can find
# their messages.
#

--- gettext-0.26/gettext-tools/tests/lang-bash.orig
+++ gettext-0.26/gettext-tools/tests/lang-bash
@@ -80,6 +80,8 @@
 
 test -d fr || mkdir fr
 test -d fr/LC_MESSAGES || mkdir fr/LC_MESSAGES
+test -L fr_FR.ISO8859-1 ||ln -s fr fr_FR.ISO8859-1
+test -L fr_FR.UTF-8 ||ln -s fr fr_FR.UTF-8
 
 : ${MSGFMT=msgfmt}
 ${MSGFMT} -c -o fr/LC_MESSAGES/prog.mo fr.po
