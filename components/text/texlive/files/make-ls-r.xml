<?xml version="1.0"?>
<!DOCTYPE service_bundle SYSTEM "/usr/share/lib/xml/dtd/service_bundle.dtd.1">
<service_bundle type='manifest' name='texlive:make-ls-r'>
<service
    name='application/texlive/make-ls-r'
    type='service'
    version='1'>
    <single_instance />
    <dependency
        name='fs-local'
        grouping='require_all'
        restart_on='none'
        type='service'>
            <service_fmri value='svc:/system/filesystem/local:default' />
    </dependency>
    <instance enabled='true' name='default'>
        <exec_method
            type='method'
            name='start'
            exec='/usr/bin/mktexlsr'
            timeout_seconds='0'/>
        <exec_method
            type='method'
            name='refresh'
            exec='/usr/bin/mktexlsr'
            timeout_seconds='0'/>
        <exec_method
            type='method'
            name='stop'
            exec=':true'
            timeout_seconds='0'/>
        <property_group name='startd' type='framework'>
            <propval name='duration' type='astring' value='transient' />
        </property_group>
    </instance>
    <stability value='Unstable' />
    <template>
        <common_name>
            <loctext xml:lang='C'>
recreate ls-R files as file lookup cache
            </loctext>
        </common_name>
    </template>
</service>
</service_bundle>
