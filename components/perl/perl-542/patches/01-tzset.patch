The tzset() is broken on illumos:
https://www.illumos.org/issues/17497

--- perl-5.42.0/ext/POSIX/t/time.t.orig
+++ perl-5.42.0/ext/POSIX/t/time.t
@@ -44,6 +44,7 @@
 SKIP: {
     skip "No tzset()", 2
        if $^O eq "VMS" || $^O eq "cygwin" ||
+          $^O eq "solaris" ||
           $^O eq "MSWin32" || $^O eq "interix";
     tzset();
     my @tzname = tzname();
