set name=pkg.fmri value=pkg:/$(COMPONENT_FMRI)@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.human-version value=$(HUMAN_VERSION)
set name=pkg.summary value="$(COMPONENT_SUMMARY)"
set name=info.classification value="$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=info.source-url value=$(COMPONENT_ARCHIVE_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)

license $(COMPONENT_LICENSE_FILE) license='$(COMPONENT_LICENSE)'
license MP/COPYING.txt license='$(COMPONENT_LICENSE), MP'

# The engines load their renderers and game modules from their own directory.
<transform file path=usr/lib/iortcw/.*\.so$ -> default pkg.linted.userland.action001.2 true>

link path=usr/bin/iortcw-ded target=../lib/iortcw/iowolfded.x86_64
link path=usr/bin/iortcw-mp target=../lib/iortcw/iowolfmp.x86_64
link path=usr/bin/iortcw-sp target=../lib/iortcw/iowolfsp.x86_64

# dlopen()ed
depend type=require fmri=__TBD pkg.debug.depend.file=usr/lib/$(MACH64)/libcurl.so.4
depend type=require fmri=__TBD pkg.debug.depend.file=usr/lib/$(MACH64)/libopenal.so.1

file path=usr/lib/iortcw/iowolfded.x86_64 mode=0555
file path=usr/lib/iortcw/iowolfmp.x86_64 mode=0555
file path=usr/lib/iortcw/iowolfsp.x86_64 mode=0555
file path=usr/lib/iortcw/main/cgame.mp.x86_64.so
file path=usr/lib/iortcw/main/cgame.sp.x86_64.so
file path=usr/lib/iortcw/main/qagame.mp.x86_64.so
file path=usr/lib/iortcw/main/qagame.sp.x86_64.so
file path=usr/lib/iortcw/main/ui.mp.x86_64.so
file path=usr/lib/iortcw/main/ui.sp.x86_64.so
file path=usr/lib/iortcw/renderer_mp_opengl1_x86_64.so
file path=usr/lib/iortcw/renderer_mp_rend2_x86_64.so
file path=usr/lib/iortcw/renderer_sp_opengl1_x86_64.so
file path=usr/lib/iortcw/renderer_sp_rend2_x86_64.so
file path=usr/share/applications/iortcw-mp.desktop
file path=usr/share/applications/iortcw-sp.desktop
file path=usr/share/icons/hicolor/128x128/apps/iortcw-mp.png
file path=usr/share/icons/hicolor/512x512/apps/iortcw-mp.png
file path=usr/share/icons/hicolor/512x512/apps/iortcw-sp.png
