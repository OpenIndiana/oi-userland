set name=pkg.fmri value=pkg:/$(COMPONENT_FMRI)@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.human-version value=$(HUMAN_VERSION)
set name=pkg.summary value="$(COMPONENT_SUMMARY)"
set name=info.classification value="$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=info.source-url value=$(COMPONENT_ARCHIVE_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)

license $(COMPONENT_LICENSE_FILE) license='$(COMPONENT_LICENSE)'

file path=usr/include/SDL3_image/SDL_image.h
file path=usr/lib/$(MACH64)/cmake/SDL3_image/SDL3_image-shared-targets-relwithdebinfo.cmake
file path=usr/lib/$(MACH64)/cmake/SDL3_image/SDL3_image-shared-targets.cmake
file path=usr/lib/$(MACH64)/cmake/SDL3_image/SDL3_imageConfig.cmake
file path=usr/lib/$(MACH64)/cmake/SDL3_image/SDL3_imageConfigVersion.cmake
link path=usr/lib/$(MACH64)/libSDL3_image.so target=libSDL3_image.so.0
link path=usr/lib/$(MACH64)/libSDL3_image.so.0 target=libSDL3_image.so.0.4.6
file path=usr/lib/$(MACH64)/libSDL3_image.so.0.4.6
file path=usr/lib/$(MACH64)/pkgconfig/sdl3-image.pc
file path=usr/share/licenses/SDL3_image/LICENSE.txt
