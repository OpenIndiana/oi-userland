file path=usr/include/p11-kit-1/p11-kit/pkcs11x.h
file path=usr/include/p11-kit-1/p11-kit/remote.h
file path=usr/include/p11-kit-1/p11-kit/uri.h
file path=usr/include/p11-kit-1/p11-kit/version.h
link path=usr/lib/$(MACH64)/libp11-kit.so target=libp11-kit.so.0
link path=usr/lib/$(MACH64)/libp11-kit.so.0 target=libp11-kit.so.0.4.10
file path=usr/lib/$(MACH64)/libp11-kit.so.0.4.10
