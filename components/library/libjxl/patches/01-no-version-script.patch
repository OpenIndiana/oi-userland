illumos ld has no --version-script. libjxl is built with hidden visibility
and JXL_EXPORT annotations, so the script only adds a version node and
hides inline std:: symbols; skip it on illumos.

Upstream status: to be offered upstream (https://github.com/libjxl/libjxl)

--- a/lib/jxl.cmake	2026-11-27 15:52:21.489767589 +0100
+++ b/lib/jxl.cmake	2026-11-27 15:52:21.513767638 +0100
@@ -255,7 +255,7 @@
       LINK_FLAGS "-Wl,-exported_symbols_list,${CMAKE_CURRENT_SOURCE_DIR}/jxl/jxl_osx.syms")
   elseif(WIN32)
     # Nothing needed here, we use __declspec(dllexport) (jxl_export.h)
-  else()
+  elseif(NOT CMAKE_SYSTEM_NAME STREQUAL "SunOS")
   set_property(TARGET ${target} APPEND_STRING PROPERTY
       LINK_FLAGS " -Wl,--version-script=${CMAKE_CURRENT_SOURCE_DIR}/jxl/jxl.version")
   endif()  # APPLE
--- a/lib/jxl_threads.cmake	2026-11-27 15:52:21.497767606 +0100
+++ b/lib/jxl_threads.cmake	2026-11-27 15:52:21.513767638 +0100
@@ -45,7 +45,7 @@
       LINK_FLAGS "-Wl,-exported_symbols_list,${CMAKE_CURRENT_SOURCE_DIR}/jxl/jxl_osx.syms")
 elseif(WIN32)
 # Nothing needed here, we use __declspec(dllexport) (jxl_threads_export.h)
-else()
+elseif(NOT CMAKE_SYSTEM_NAME STREQUAL "SunOS")
   set_property(TARGET jxl_threads APPEND_STRING PROPERTY
       LINK_FLAGS " -Wl,--version-script=${CMAKE_CURRENT_SOURCE_DIR}/jxl/jxl.version")
 endif()  # APPLE
