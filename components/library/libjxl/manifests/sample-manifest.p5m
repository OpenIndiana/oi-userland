set name=pkg.fmri value=pkg:/$(COMPONENT_FMRI)@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.human-version value=$(HUMAN_VERSION)
set name=pkg.summary value="$(COMPONENT_SUMMARY)"
set name=info.classification value="$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=info.source-url value=$(COMPONENT_ARCHIVE_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)

license $(COMPONENT_LICENSE_FILE) license='$(COMPONENT_LICENSE)'

file path=usr/bin/cjxl
file path=usr/bin/djxl
file path=usr/bin/jxlinfo
file path=usr/bin/jxltran
file path=usr/include/jxl/cms.h
file path=usr/include/jxl/cms_interface.h
file path=usr/include/jxl/codestream_header.h
file path=usr/include/jxl/color_encoding.h
file path=usr/include/jxl/compressed_icc.h
file path=usr/include/jxl/decode.h
file path=usr/include/jxl/decode_cxx.h
file path=usr/include/jxl/encode.h
file path=usr/include/jxl/encode_cxx.h
file path=usr/include/jxl/gain_map.h
file path=usr/include/jxl/jxl_cms_export.h
file path=usr/include/jxl/jxl_export.h
file path=usr/include/jxl/jxl_threads_export.h
file path=usr/include/jxl/memory_manager.h
file path=usr/include/jxl/parallel_runner.h
file path=usr/include/jxl/resizable_parallel_runner.h
file path=usr/include/jxl/resizable_parallel_runner_cxx.h
file path=usr/include/jxl/stats.h
file path=usr/include/jxl/thread_parallel_runner.h
file path=usr/include/jxl/thread_parallel_runner_cxx.h
file path=usr/include/jxl/types.h
file path=usr/include/jxl/version.h
file path=usr/lib/$(MACH64)/gdk-pixbuf-2.0/2.10.0/loaders/libpixbufloader-jxl.so
link path=usr/lib/$(MACH64)/libjxl.so target=libjxl.so.0.12
file path=usr/lib/$(MACH64)/libjxl.so.$(HUMAN_VERSION)
link path=usr/lib/$(MACH64)/libjxl.so.0.12 target=libjxl.so.$(HUMAN_VERSION)
link path=usr/lib/$(MACH64)/libjxl_cms.so target=libjxl_cms.so.0.12
file path=usr/lib/$(MACH64)/libjxl_cms.so.$(HUMAN_VERSION)
link path=usr/lib/$(MACH64)/libjxl_cms.so.0.12 \
    target=libjxl_cms.so.$(HUMAN_VERSION)
file path=usr/lib/$(MACH64)/libjxl_extras_codec.a
link path=usr/lib/$(MACH64)/libjxl_threads.so target=libjxl_threads.so.0.12
file path=usr/lib/$(MACH64)/libjxl_threads.so.$(HUMAN_VERSION)
link path=usr/lib/$(MACH64)/libjxl_threads.so.0.12 \
    target=libjxl_threads.so.$(HUMAN_VERSION)
file path=usr/lib/$(MACH64)/pkgconfig/libjxl.pc
file path=usr/lib/$(MACH64)/pkgconfig/libjxl_cms.pc
file path=usr/lib/$(MACH64)/pkgconfig/libjxl_threads.pc
file path=usr/share/mime/packages/image-jxl.xml
file path=usr/share/thumbnailers/jxl.thumbnailer
