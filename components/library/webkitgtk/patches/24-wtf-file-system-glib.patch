+#elif OS(SOLARIS)
+CString currentExecutablePath()
+{
+    static char readLinkBuffer[PATH_MAX], path[64];
+    snprintf(path, sizeof(path), "/proc/%ld/path/a.out", static_cast<long>(getpid()));
+    ssize_t result = readlink(path, readLinkBuffer, PATH_MAX);
+    if (result == -1)
+        return { };
+    return CString(unsafeMakeSpan(readLinkBuffer, result));
+}
