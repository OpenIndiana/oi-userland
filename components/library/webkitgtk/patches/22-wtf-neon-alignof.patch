-    if (tmp > UINT16_MAX) tmp = UINT16_MAX;
+    if (tmp > (int32_t)UINT16_MAX) tmp = UINT16_MAX;
     else if (tmp < 0) tmp = 0;
     r_.values[i] = HEDLEY_STATIC_CAST(uint16_t, tmp);
   }
@@ -121284,7 +121284,7 @@
