     int16_t tmp = HEDLEY_STATIC_CAST(int16_t, (a_.values[i] + (1 << (n - 1))) >> n);
-    if (tmp > UINT8_MAX) tmp = UINT8_MAX;
+    if (tmp > (int16_t)UINT8_MAX) tmp = UINT8_MAX;
     else if (tmp < 0) tmp = 0;
     r_.values[i] = HEDLEY_STATIC_CAST(uint8_t, tmp);
