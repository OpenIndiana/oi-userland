set name=pkg.fmri value=pkg:/$(COMPONENT_FMRI)@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.human-version value=$(HUMAN_VERSION)
set name=pkg.summary value="$(COMPONENT_SUMMARY)"
set name=info.classification value="$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=info.source-url value=$(COMPONENT_ARCHIVE_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)

license $(COMPONENT_LICENSE_FILE) license='$(COMPONENT_LICENSE)'

# Illumos provides a bunch of qemu files with system/qemu/kvm. Make sure
# it is installed
depend type=require fmri=system/qemu/kvm

<transform file path=usr/bin/qemu-system- -> set mode 04555>
<transform file path=usr/bin/qemu-system- -> set owner root>

<transform file path=usr/share/qemu/.*\.img$ -> \
	add pkg.linted.userland.action001.2 true>

# Do not substitute these files with the packaging macro $(MACH),
# they otherwise don't get delivered on NONE x86_64 architectures.
file path=usr/share/doc/qemu/system/i386/amd-memory-encryption.html
file path=usr/share/doc/qemu/system/i386/cpu.html
file path=usr/share/doc/qemu/system/i386/hyperv.html
file path=usr/share/doc/qemu/system/i386/kvm-pv.html
file path=usr/share/doc/qemu/system/i386/microvm.html
file path=usr/share/doc/qemu/system/i386/nitro-enclave.html
file path=usr/share/doc/qemu/system/i386/pc.html
file path=usr/share/doc/qemu/system/i386/sgx.html
file path=usr/share/doc/qemu/system/i386/tdx.html
file path=usr/share/doc/qemu/system/i386/xen.html
file path=usr/share/doc/qemu/system/i386/xenpvh.html

# Do not include files found in system/qemu/kvm package
<transform path=usr/share/qemu/keymaps/.* -> drop>
<transform path=usr/bin/qemu-keymap -> drop>
<transform path=usr/share/qemu/bios.bin -> drop>
<transform path=usr/share/qemu/openbios-ppc -> drop>
<transform path=usr/share/qemu/openbios-sparc32 -> drop>
<transform path=usr/share/qemu/openbios-sparc64 -> drop>
<transform path=usr/share/qemu/vgabios-cirrus.bin -> drop>
<transform path=usr/share/qemu/vgabios-qxl.bin -> drop>
<transform path=usr/share/qemu/vgabios-stdvga.bin -> drop>
<transform path=usr/share/qemu/vgabios-vmware.bin -> drop>
<transform path=usr/share/qemu/vgabios.bin -> drop>

# Do not include libfdt subproject
<transform path=usr/include/fdt.h -> drop>
<transform path=usr/include/libfdt.h -> drop>
<transform path=usr/include/libfdt_env.h -> drop>
<transform path=usr/lib/$(MACH64)/libfdt.a -> drop>
<transform path=usr/lib/$(MACH64)/pkgconfig/libfdt.pc -> drop>

# Add linkes to files in system/qemu/kvm package
# (Comment out files in lower section of file)
link path=usr/share/qemu/dtb/bamboo.dtb target=usr/share/qemu/bamboo.dtb pkg.linted.userland.action002.0=true
link path=usr/share/qemu/dtb/petalogix-s3adsp1800.dtb target=usr/share/qemu/petalogix-s3adsp1800.dtb pkg.linted.userland.action002.0=true

file files/exec_attr path=etc/security/exec_attr.d/system:qemu

#
# The files commented out below are ones which conflict with those delivered
# from system/qemu/kvm
#

