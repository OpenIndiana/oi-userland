[general]
method=isa-serial
# NOTE: If your hypervisor provides a common serial port for Guest Agent
#  integration, be sure to NOT name it in `eeprom` as a `console`,
#  `input-device` or `output-device` (otherwise `qm agent ping` from the
#  hypervisor can interrupt very early boot phases if timed just right)!
#MAYBE# path=/devices/pci@0,0/isa@1/asy@1,3f8:a
#MAYBE# path=/dev/ttya
#MAYBE# path=/devices/pci@0,0/isa@1/asy@1,2f8:b
path=/dev/ttyb
daemon=false
pidfile=/var/run/qemu-ga.pid
logfile=/var/log/qemu-ga.log
statedir=/var/run
verbose=false
#OBSOLETE# blacklist=
block-rpcs=
