[general]
method=virtio-serial
# NOTE: Actual virtio-port (vioserial) device may be missing in illumos;
#  may be seen as a PCI device or a nicer link, would be something like:
#MAYBE# path=/devices/pci@0,0/pci1b36,1@5/pci1af4,3@1:a
path=/dev/virtio-ports/org.qemu.guest_agent.0
daemon=false
pidfile=/var/run/qemu-ga.pid
logfile=/var/log/qemu-ga.log
statedir=/var/run
verbose=false
#OBSOLETE# blacklist=
block-rpcs=
