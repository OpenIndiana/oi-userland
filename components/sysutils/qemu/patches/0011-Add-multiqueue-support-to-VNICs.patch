-		ret = qemu_send_packet_async(&vsp->vns_nc, vsp->vns_buf, ret,
+		vsp = vnic_select_queue(vsh, vsh->vsh_buf, ret);
+		ret = qemu_send_packet_async(&vsp->vns_nc, vsh->vsh_buf, ret,
 		    vnic_send_completed);
 
 		if (ret == 0)
-			vnic_read_poll(vsp, false);
+			vnic_read_poll(vsh, false);
 
-	} while (ret > 0 && qemu_can_send_packet(&vsp->vns_nc));
+	} while (ret > 0);
 }
 
