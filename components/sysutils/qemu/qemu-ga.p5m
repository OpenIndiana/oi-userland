set name=pkg.fmri value=pkg:/$(COMPONENT_FMRI)-ga@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.human-version value=$(HUMAN_VERSION)
set name=pkg.summary value="$(COMPONENT_SUMMARY) - QEMU Guest Agent"
set name=info.classification value="$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=info.source-url value=$(COMPONENT_ARCHIVE_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)

license $(COMPONENT_LICENSE_FILE) license='$(COMPONENT_LICENSE)'

# Do not include files found in system/qemu/kvm package
<transform path=usr/share/qemu/keymaps/.* -> drop>
<transform path=usr/bin/qemu-keymap -> drop>
<transform path=usr/share/qemu/bios.bin -> drop>
<transform path=usr/share/qemu/openbios-ppc -> drop>
<transform path=usr/share/qemu/openbios-sparc32 -> drop>
<transform path=usr/share/qemu/openbios-sparc64 -> drop>
<transform path=usr/share/qemu/vgabios-cirrus.bin -> drop>
<transform path=usr/share/qemu/vgabios-qxl.bin -> drop>
<transform path=usr/share/qemu/vgabios-stdvga.bin -> drop>
<transform path=usr/share/qemu/vgabios-vmware.bin -> drop>
<transform path=usr/share/qemu/vgabios.bin -> drop>

# Do not include libfdt subproject
<transform path=usr/include/fdt.h -> drop>
<transform path=usr/include/libfdt.h -> drop>
<transform path=usr/include/libfdt_env.h -> drop>
<transform path=usr/lib/$(MACH64)/libfdt.a -> drop>
<transform path=usr/lib/$(MACH64)/pkgconfig/libfdt.pc -> drop>

file files/qemu-ga.conf.sample-isa-serial    path=etc/qemu/qemu-ga.conf.sample-isa-serial
file files/qemu-ga.conf.sample-virtio-serial path=etc/qemu/qemu-ga.conf.sample-virtio-serial

file files/qemu-ga.xml \
     path=lib/svc/manifest/system/qemu-ga.xml \
     restart_fmri=svc:/system/manifest-import:default

# Include only files related to QEMU Guest Agent
# (installed into illumos-based virtual machines)
dir  path=usr
dir  path=usr/bin
file path=usr/bin/qemu-ga

dir  path=usr/share
dir  path=usr/share/man
dir  path=usr/share/man/man7
dir  path=usr/share/man/man8
file path=usr/share/man/man7/qemu-ga-ref.7
file path=usr/share/man/man8/qemu-ga.8

# HTML docs are left as a consistent cross-linked wad in qemu-server package:
#file path=usr/share/doc/qemu/interop/qemu-ga-ref.html
#file path=usr/share/doc/qemu/interop/qemu-ga.html
#file path=usr/share/doc/qemu/qapi-qga-index.html
