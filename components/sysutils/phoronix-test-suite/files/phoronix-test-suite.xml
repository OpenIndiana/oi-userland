<service_bundle type='manifest' name='phoronix-test-suite'>
  <service name='application/phoronix-test-suite/phoromatic-client'
           type='service' version='1'>
    <dependency name='filesystem' grouping='require_all'
                restart_on='none' type='service'>
      <service_fmri value='svc:/system/filesystem/local'/>
    </dependency>
    <dependency name='network' grouping='require_all'
                restart_on='none' type='service'>
      <service_fmri value='svc:/milestone/network'/>
    </dependency>
    <instance name='default' enabled='false'>
      <exec_method type='method' name='start'
                   exec='/lib/svc/method/phoronix-test-suite phoromatic-client'
                   timeout_seconds='300'/>
      <exec_method type='method' name='stop' exec=':kill'
                   timeout_seconds='60'/>
      <template>
        <common_name>
          <loctext xml:lang='C'>Phoronix Test Suite Phoromatic client</loctext>
        </common_name>
      </template>
    </instance>
  </service>

  <service name='application/phoronix-test-suite/phoromatic-server'
           type='service' version='1'>
    <dependency name='filesystem' grouping='require_all'
                restart_on='none' type='service'>
      <service_fmri value='svc:/system/filesystem/local'/>
    </dependency>
    <dependency name='network' grouping='require_all'
                restart_on='none' type='service'>
      <service_fmri value='svc:/milestone/network'/>
    </dependency>
    <instance name='default' enabled='false'>
      <exec_method type='method' name='start'
                   exec='/lib/svc/method/phoronix-test-suite phoromatic-server'
                   timeout_seconds='300'/>
      <exec_method type='method' name='stop' exec=':kill'
                   timeout_seconds='60'/>
      <template>
        <common_name>
          <loctext xml:lang='C'>Phoronix Test Suite Phoromatic server</loctext>
        </common_name>
      </template>
    </instance>
  </service>

  <service name='application/phoronix-test-suite/result-viewer'
           type='service' version='1'>
    <dependency name='filesystem' grouping='require_all'
                restart_on='none' type='service'>
      <service_fmri value='svc:/system/filesystem/local'/>
    </dependency>
    <dependency name='network' grouping='require_all'
                restart_on='none' type='service'>
      <service_fmri value='svc:/milestone/network'/>
    </dependency>
    <instance name='default' enabled='false'>
      <exec_method type='method' name='start'
                   exec='/lib/svc/method/phoronix-test-suite result-viewer'
                   timeout_seconds='300'/>
      <exec_method type='method' name='stop' exec=':kill'
                   timeout_seconds='60'/>
      <template>
        <common_name>
          <loctext xml:lang='C'>Phoronix Test Suite result viewer</loctext>
        </common_name>
      </template>
    </instance>
  </service>
</service_bundle>
