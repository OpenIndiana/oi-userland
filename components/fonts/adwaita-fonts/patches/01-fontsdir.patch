Install into /usr/share/fonts/TrueType/adwaita, where OpenIndiana keeps its
TrueType fonts (one directory per family), instead of <datadir>/fonts/Adwaita.
OpenIndiana-specific; not for upstream.
Upstream: https://gitlab.gnome.org/GNOME/adwaita-fonts

--- adwaita-fonts-50.0/meson.build.orig
+++ adwaita-fonts-50.0/meson.build
@@ -6,7 +6,7 @@
 
 datadir = get_option('datadir')
 
-fontsdir = join_paths(datadir, 'fonts', 'Adwaita')
+fontsdir = join_paths(datadir, 'fonts', 'TrueType', 'adwaita')
 
 mono = [
   'mono/AdwaitaMono-BoldItalic.ttf',
