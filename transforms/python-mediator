<transform file link -> default tmp.fmri %{pkg.fmri} >

# Create unversioned symlinks in /usr/bin and /usr/share/man
<transform file path=(usr/bin/|usr/share/man/man[^/]+/)([^/]*[^-/])(-?$(PYVER_RE))(.*)$ \
    tmp.fmri=(.*runtime/python.*|.*library/python/.*)$ -> \
    emit link path=%<1>%<2>%<4> target=%<2>%<3>%<4> tmp.fmri=%<5> >

# All symlinks with unversioned path should be mediated
<transform link path=(?!.*$(PYVER_RE)) tmp.fmri=.*runtime/python|.*library/python/ -> \
    default mediator python >
<transform link path=(?!.*$(PYVER_RE)) tmp.fmri=.*runtime/python|.*library/python/ -> \
    default mediator-version $(PYVER) >

<transform file link tmp.fmri=.* -> delete tmp.fmri .* >
